{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "arc-runners chart values",
  "description": "Open, not strict: only types, and the inputs the chart cannot work without. The estate facts -- the organization, the controller's namespace, and the remote builders' hosts -- have no default.",
  "type": "object",
  "required": [
    "githubConfigUrl",
    "controllerServiceAccount"
  ],
  "properties": {
    "githubConfigUrl": {
      "type": "string",
      "minLength": 1,
      "description": "The organization this release registers against: https://github.com/<org>."
    },
    "githubConfigSecret": {
      "type": "string",
      "minLength": 1
    },
    "arcVersion": {
      "type": "string",
      "minLength": 1
    },
    "controllerServiceAccount": {
      "type": "object",
      "required": [
        "name",
        "namespace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "description": "Where the estate installed the ARC controller. No default."
        }
      }
    },
    "runnerServiceAccountName": {
      "type": "string"
    },
    "runnerImage": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "minRunners": {
      "type": "integer",
      "minimum": 0
    },
    "maxRunners": {
      "type": "integer",
      "minimum": 0
    },
    "nixBuilders": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "builders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "system",
              "maxJobs",
              "speedFactor"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "ci-builders' worker Service: nix-worker-<arch>.<namespace>.svc.cluster.local."
              },
              "system": {
                "type": "string",
                "minLength": 1
              },
              "maxJobs": {
                "type": "integer",
                "minimum": 1
              },
              "speedFactor": {
                "type": "integer",
                "minimum": 1
              },
              "supportedFeatures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mandatoryFeatures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "The remote builders. Required, and non-empty, while nixBuilders is enabled."
        }
      },
      "if": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "builders"
        ],
        "properties": {
          "builders": {
            "minItems": 1
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "projectedServiceAccountTokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "audience",
          "path"
        ],
        "properties": {
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expirationSeconds": {
            "type": "integer",
            "minimum": 600,
            "description": "The Kubernetes TokenRequest API's own floor."
          }
        }
      }
    },
    "awsConfig": {
      "type": "object",
      "description": "Empty/disabled by default: no ConfigMap, no mount, neither AWS_CONFIG_FILE nor AWS_PROFILE set. templates/runnersets.yaml also refuses this alongside an extraEnv entry named AWS_ACCESS_KEY_ID -- a check this schema cannot express.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string"
        },
        "credentialProcess": {
          "type": "string"
        }
      },
      "if": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "credentialProcess"
        ],
        "properties": {
          "profile": {
            "minLength": 1
          },
          "credentialProcess": {
            "minLength": 1
          }
        }
      }
    },
    "nixCache": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "When set, becomes the first entry of a full `substituters = <url> https://cache.nixos.org/` line rendered into NIX_CONFIG. Empty default: the image's own baked cache.nixos.org-only substituter list stands."
        }
      }
    },
    "nixSandbox": {
      "type": "object",
      "description": "Release-wide switch only. A scale set's own nixSandbox.enabled/seccompProfile live under scaleSets.<name> -- open, not schema-checked here, same as the rest of a scale set's fields -- and are refused at render time instead (templates/runnersets.yaml) when enabled with no profile.",
      "properties": {
        "fence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "packing": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "scaleSets": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "janitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "graceSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
