{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "arc-runners chart values",
  "description": "Open, not strict: only types, and the inputs the chart cannot work without. The estate facts -- the organization, the controller's namespace, and the remote builders' hosts -- have no default.",
  "type": "object",
  "required": [
    "githubConfigUrl",
    "controllerServiceAccount"
  ],
  "properties": {
    "githubConfigUrl": {
      "type": "string",
      "minLength": 1,
      "description": "The organization this release registers against: https://github.com/<org>."
    },
    "githubConfigSecret": {
      "type": "string",
      "minLength": 1
    },
    "arcVersion": {
      "type": "string",
      "minLength": 1
    },
    "controllerServiceAccount": {
      "type": "object",
      "required": [
        "name",
        "namespace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "description": "Where the estate installed the ARC controller. No default."
        }
      }
    },
    "runnerServiceAccountName": {
      "type": "string"
    },
    "runnerUser": {
      "type": "object",
      "description": "The numeric login of the runner image's user, rendered for scale sets with restricted: true.",
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "gid": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runnerImage": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "restricted": {
      "type": "boolean"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "containment": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "annotations": {
              "type": "object"
            },
            "serviceCidr": {
              "type": "string"
            },
            "vpcCidr": {
              "type": "string"
            },
            "cacheNamespace": {
              "type": "string"
            },
            "metricsFrom": {
              "type": "object",
              "properties": {
                "namespaceSelector": {
                  "type": "object"
                },
                "podSelector": {
                  "type": "object"
                }
              },
              "additionalProperties": false,
              "anyOf": [
                { "required": ["namespaceSelector"] },
                { "required": ["podSelector"] }
              ]
            }
          }
        }
      }
    },
    "minRunners": {
      "type": "integer",
      "minimum": 0
    },
    "maxRunners": {
      "type": "integer",
      "minimum": 0
    },
    "nixBuilders": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "builders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "system",
              "maxJobs",
              "speedFactor"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "ci-builders' worker Service: nix-worker-<arch>.<namespace>.svc.cluster.local."
              },
              "system": {
                "type": "string",
                "minLength": 1
              },
              "maxJobs": {
                "type": "integer",
                "minimum": 1
              },
              "speedFactor": {
                "type": "integer",
                "minimum": 1
              },
              "supportedFeatures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mandatoryFeatures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "The remote builders. Required, and non-empty, while nixBuilders is enabled."
        }
      },
      "if": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "builders"
        ],
        "properties": {
          "builders": {
            "minItems": 1
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "affinity": {
      "type": "object"
    },
    "nodeClass": {
      "type": "string",
      "description": "Name of a class under nodeClasses; the placement of every runner pod unless its scale set names its own."
    },
    "nodeClasses": {
      "type": "object",
      "description": "Placement classes you define: name -> nodeSelector / tolerations / affinity.",
      "additionalProperties": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
          "tolerations": {"type": "array", "items": {"type": "object"}},
          "affinity": {"type": "object"}
        }
      }
    },
    "sizes": {
      "type": "object",
      "description": "Runner sizes you define: name -> gomaxprocs / resources / maxRunners.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gomaxprocs": {"type": "integer", "minimum": 1},
          "maxRunners": {"type": "integer", "minimum": 1},
          "resources": {"type": "object"}
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "projectedServiceAccountTokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "audience",
          "path"
        ],
        "properties": {
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expirationSeconds": {
            "type": "integer",
            "minimum": 600,
            "description": "The Kubernetes TokenRequest API's own floor."
          }
        }
      }
    },
    "buildkitTLS": {
      "type": "object",
      "description": "Client side of the mutual-TLS BuildKit builders. Off by default: nothing rendered, mounted or set.",
      "properties": {
        "enabled": {"type": "boolean"},
        "mountPath": {"type": "string", "minLength": 1},
        "serverName": {"type": "string"},
        "secretName": {"type": "string"},
        "certificate": {
          "type": "object",
          "properties": {
            "create": {"type": "boolean"},
            "commonName": {"type": "string", "minLength": 1}
          }
        },
        "ca": {
          "type": "object",
          "properties": {
            "configMapName": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "awsConfig": {
      "type": "object",
      "description": "Empty/disabled by default: no ConfigMap, no mount, neither AWS_CONFIG_FILE nor AWS_PROFILE set. templates/runnersets.yaml also refuses this alongside an extraEnv entry named AWS_ACCESS_KEY_ID -- a check this schema cannot express.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string"
        },
        "credentialProcess": {
          "type": "string"
        }
      },
      "if": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "credentialProcess"
        ],
        "properties": {
          "profile": {
            "minLength": 1
          },
          "credentialProcess": {
            "minLength": 1
          }
        }
      }
    },
    "nixCache": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "When set, becomes the first entry of a full `substituters = <url> https://cache.nixos.org/` line rendered into NIX_CONFIG. Empty default: the image's own cache.nixos.org-only substituter list stands."
        }
      }
    },
    "nixSandbox": {
      "type": "object",
      "description": "Release-wide switch only. A scale set's own nixSandbox.enabled/seccompProfile live under scaleSets.<name> -- open, not schema-checked here, same as the rest of a scale set's fields -- and are refused at render time instead (templates/runnersets.yaml) when enabled with no profile.",
      "properties": {
        "fence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "packing": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "scaleSets": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "extraCACertificates": {
      "type": "object",
      "description": "Off while neither configMapName nor secretName is set. templates/runnersets.yaml also refuses both being set, and a key not ending in .pem or .crt -- checks this schema cannot express.",
      "properties": {
        "configMapName": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]+$"
        }
      }
    },
    "runner": {
      "type": "object",
      "properties": {
        "watchdog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "grace": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
            },
            "drillFile": {
              "type": "string",
              "pattern": "^(/[A-Za-z0-9._/-]+)?$"
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": {
          "type": "string",
          "pattern": "^(([0-9]+(\\.[0-9]+)?(ms|s|m|h))+)?$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "watchdog": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "listener": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "janitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "graceSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "notReadySeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
