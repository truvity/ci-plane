Port 2222
ListenAddress 0.0.0.0
AddressFamily any
HostKey /etc/nix-worker/ssh/ssh_host_ed25519_key
PidFile /run/nix-worker/sshd.pid
AuthorizedKeysFile none
TrustedUserCAKeys /etc/nix-worker/ca/trusted_user_ca_keys

PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
UsePAM no
AllowUsers nixremote
StrictModes yes
DisableForwarding yes

AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
PermitTTY no
X11Forwarding no
PermitUserEnvironment no
GatewayPorts no

ForceCommand /usr/local/bin/nix-worker-ssh-command
LogLevel VERBOSE

# A SECOND login (INF host-certificates phase 1): the modern ssh-ng
# protocol via `nix-daemon --stdio`, gated independently of `nixremote`
# above. AuthorizedPrincipalsFile, not a fixed principal: the chart
# renders /etc/nix-worker/principals/nix from
# nixWorkers.accounts.nix.principals, and an EMPTY file (the default)
# means no principal matches, so a certificate signed by the trusted CA
# above still cannot log in as `nix` -- AllowUsers above gains `nix` only
# when that list is non-empty (nix-worker-entrypoint.sh), which is what
# actually determines whether this Match block is ever reached.
Match User nix
    AuthorizedPrincipalsFile /etc/nix-worker/principals/%u
    ForceCommand /usr/local/libexec/nix-worker/nix-daemon --stdio
    PermitTTY no
    DisableForwarding yes
